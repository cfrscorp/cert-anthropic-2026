{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice-question pool component (one difficulty tier)",
  "description": "Exam-neutral pool items: no domain/task tags — each exam's map.json assigns the items it uses to its own task statements.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "stem", "options", "correct", "rationale", "difficulty"],
    "properties": {
      "id": { "description": "Opaque, stable pool ID; the task it counts toward is per exam (exams/<slug>/map.json).", "type": "string", "pattern": "^q-[0-9]{4,}$" },
      "scenario": { "type": ["string", "null"] },
      "stem": { "type": "string", "minLength": 10 },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "text"],
          "properties": {
            "key": { "enum": ["A", "B", "C", "D", "E"] },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      },
      "correct": {
        "description": "A single letter for a normal item, or an array of 2+ letters for a multi-response ('Select N') item.",
        "oneOf": [
          { "enum": ["A", "B", "C", "D", "E"] },
          {
            "type": "array",
            "items": { "enum": ["A", "B", "C", "D", "E"] },
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true
          }
        ]
      },
      "rationale": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correct", "distractors"],
        "properties": {
          "correct": { "type": "string", "minLength": 1 },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 },
              "E": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "lab": { "type": ["string", "null"], "pattern": "^lab-[0-9]{2}-" },
      "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
