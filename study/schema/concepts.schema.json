{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept-explainer component",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "task_statement", "domain", "title", "concept", "why_it_matters", "common_trap"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+-concept-[0-9]+\\.[0-9]+$" },
      "task_statement": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
      "domain": { "type": "integer", "minimum": 1 },
      "title": { "type": "string", "minLength": 1 },
      "concept": { "type": "string", "minLength": 1 },
      "why_it_matters": { "type": "string", "minLength": 1 },
      "common_trap": { "type": "string", "minLength": 1 },
      "lab": { "type": ["string", "null"], "pattern": "^lab-[0-9]{2}-" },
      "code_samples": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "code"],
          "properties": {
            "caption": { "type": "string", "minLength": 1 },
            "language": { "enum": ["python", "json", "yaml", "bash", "markdown", "text"] },
            "code": { "type": "string", "minLength": 1 }
          }
        }
      },
      "videos": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
