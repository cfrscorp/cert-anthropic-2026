{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept-explainer pool component",
  "description": "Exam-neutral pool items: no domain/task tags — each exam's map.json assigns the items it uses to its own task statements.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "concept", "why_it_matters", "common_trap"],
    "properties": {
      "id": { "description": "Opaque, stable pool ID; the task it counts toward is per exam (exams/<slug>/map.json).", "type": "string", "pattern": "^concept-[0-9]{4,}$" },
      "title": { "type": "string", "minLength": 1 },
      "concept": { "type": "string", "minLength": 1 },
      "why_it_matters": { "type": "string", "minLength": 1 },
      "common_trap": { "type": "string", "minLength": 1 },
      "lab": { "type": ["string", "null"], "pattern": "^lab-[0-9]{2}-" },
      "code_samples": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "code"],
          "properties": {
            "caption": { "type": "string", "minLength": 1 },
            "language": { "enum": ["python", "json", "yaml", "bash", "markdown", "text"] },
            "code": { "type": "string", "minLength": 1 }
          }
        }
      },
      "videos": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
