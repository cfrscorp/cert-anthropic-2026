{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labs catalog component (generated by tools/build_labs.py)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slug", "number", "title", "readme_html", "solution_html"],
    "properties": {
      "slug": { "type": "string", "pattern": "^lab-[0-9]{2}-" },
      "number": { "type": "integer", "minimum": 1 },
      "title": { "type": "string", "minLength": 1 },
      "readme_html": { "type": "string", "minLength": 1 },
      "solution_html": { "type": "string" }
    }
  }
}
